{
    "$schema":  "../gen/schemas/desktop-schema.json",
    "identifier":  "instagram-inbox",
    "description":  "Native Instagram access: Meta Graph API hosts, Instagram sign-in page and Elsewhere's Instagram sign-in helper",
    "windows":  [
                    "instagram-inbox",
                    "main"
                ],
    "permissions":  [
                        "core:default",
                        {
                            "identifier":  "http:default",
                            "allow":  [
                                          {
                                              "url":  "https://graph.facebook.com/**"
                                          },
                                          {
                                              "url":  "https://graph.instagram.com/**"
                                          },
                                          {
                                              "url":  "https://*.supabase.co/functions/v1/elsewhere-instagram-auth"
                                          },
                                          {
                                              "url":  "https://*.supabase.co/functions/v1/elsewhere-account-delete"
                                          },
                                          {
                                              "url":  "https://*.supabase.co/functions/v1/elsewhere-tester-request"
                                          }
                                      ]
                        },
                        {
                            "identifier":  "opener:allow-open-url",
                            "allow":  [
                                          {
                                              "url":  "https://www.facebook.com/v27.0/dialog/oauth*"
                                          }
                                      ]
                        }
                    ]
}
