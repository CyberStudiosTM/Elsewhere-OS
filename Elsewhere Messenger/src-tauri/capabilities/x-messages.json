{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "x-messages",
  "description": "X OAuth and direct messages for Elsewhere’s main window",
  "windows": ["main"],
  "permissions": [
    {"identifier": "opener:allow-open-url", "allow": [{"url": "https://x.com/i/oauth2/authorize*"}]},
    {"identifier": "http:default", "allow": [
      {"url": "https://api.x.com/2/oauth2/token"},
      {"url": "https://api.x.com/2/users/me*"},
      {"url": "https://api.x.com/2/users/by/username/*"},
      {"url": "https://api.x.com/2/dm_events*"},
      {"url": "https://api.x.com/2/dm_conversations/*"}
    ]}
  ]
}
